# ---- LLM (pick one: gemini | groq | openrouter | mock) ----
LLM_PROVIDER=gemini
LLM_MODEL=                       # blank = provider default (gemini-flash-latest). Free-tier model names change - override here.
GOOGLE_API_KEY=                  # https://aistudio.google.com/apikey  (free, no card)
GROQ_API_KEY=                    # https://console.groq.com            (free)
OPENROUTER_API_KEY=              # https://openrouter.ai/keys          (":free" models)

# ---- PostgreSQL (Neon free plan). Blank = local SQLite file for quick dev ----
# Format: postgresql+psycopg2://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ---- Pinecone (Starter plan, free). Blank = in-memory vector store (lost on restart) ----
PINECONE_API_KEY=
PINECONE_INDEX=docgen-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1        # Starter plan indexes are limited to AWS us-east-1

# ---- RAG / research ----
EMBEDDING_BACKEND=fastembed      # fastembed | hash (offline fallback, lower quality)
WEB_SEARCH=true

# ---- Files / security ----
MAX_UPLOAD_MB=15
CORS_ORIGINS=http://localhost:5173
APP_API_KEY=                     # optional shared secret; send as X-API-Key (frontend: VITE_API_KEY)
